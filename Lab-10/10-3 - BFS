#include <stdio.h>
#include <stdlib.h>

#define MAX 10

struct Node {
    int data;
    struct Node* next;
};

struct Node* adj[MAX];
int visited[MAX];
int n = 0;

// Queue implementation
int queue[MAX], front = -1, rear = -1;

void enqueue(int x) {
    if (rear == MAX - 1) return;
    if (front == -1) front = 0;
    queue[++rear] = x;
}

int dequeue() {
    if (front == -1) return -1;
    int val = queue[front];
    if (front == rear)
        front = rear = -1;
    else
        front++;
    return val;
}

// Create node
struct Node* createNode(int v) {
    struct Node* temp = (struct Node*)malloc(sizeof(struct Node));
    temp->data = v;
    temp->next = NULL;
    return temp;
}

// Add node
void addNode() {
    adj[n] = NULL;
    n++;
}

// Insert edge u -> v
void insertEdge(int u, int v) {
    struct Node* temp = createNode(v);
    temp->next = adj[u];
    adj[u] = temp;
}

// BFS function
void BFS(int start) {
    for (int i = 0; i < n; i++)
        visited[i] = 0;

    enqueue(start);
    visited[start] = 1;

    printf("BFS Traversal: ");

    while (front != -1) {
        int current = dequeue();
        printf("%d ", current);

        struct Node* temp = adj[current];
        while (temp) {
            if (!visited[temp->data]) {
                enqueue(temp->data);
                visited[temp->data] = 1;
            }
            temp = temp->next;
        }
    }
    printf("\n");
}

// Main
int main() {
    // Example graph
    n = 5;

    for (int i = 0; i < n; i++)
        adj[i] = NULL;

    insertEdge(0, 1);
    insertEdge(0, 2);
    insertEdge(1, 3);
    insertEdge(2, 4);

    BFS(0);

    return 0;
}
